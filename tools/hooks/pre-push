#!/bin/sh
# Personal-data check on everything a push would send, every commit's message, author and files
# (AGENTS.md rule 11). Git passes the refs on standard input.
root=$(git rev-parse --show-toplevel) || exit 0
py=$(command -v python3 || command -v python || command -v py) || py=
if [ -z "$py" ]; then
  echo "personal-data check SKIPPED: Python was not found (CI still checks every push)" >&2
  exit 0
fi
exec "$py" "$root/tools/personal_scan.py" --pre-push
